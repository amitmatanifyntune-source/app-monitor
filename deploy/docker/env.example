# Copy to .env (install.sh does this and fills the secrets for you). Never commit .env.

# The monitor's public name. A DNS record must point at this server, e.g. monitor.example.com.
# No domain yet? Use the server's IP with dashes + .sslip.io, e.g. 13-55-12-34.sslip.io
SITE=monitor.example.com

DB_PASSWORD=change-me                  # openssl rand -hex 24
APP_JWT_SECRET=change-me               # openssl rand -base64 48   (at least 32 bytes)
MONITOR_ADMIN_PASSWORD=change-me       # first administrator "admin"; used once, on first start

# optional
# SERVER_MEM_LIMIT=1g
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
