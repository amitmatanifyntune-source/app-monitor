# systemd unit for the Fyntune agent (Linux).
#   sudo useradd --system --home /opt/fyntune-agent --shell /usr/sbin/nologin fyntune-agent
#   sudo mkdir -p /opt/fyntune-agent && sudo cp fyntune-agent.jar agent.json /opt/fyntune-agent/
#   sudo chown -R fyntune-agent: /opt/fyntune-agent && sudo chmod 600 /opt/fyntune-agent/agent.json
#   sudo usermod -aG adm fyntune-agent          # read /var/log/nginx (Debian/Ubuntu; use the log files' group elsewhere)
#   sudo cp fyntune-agent.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now fyntune-agent && journalctl -u fyntune-agent -f
[Unit]
Description=Fyntune App Monitor agent
After=network-online.target
Wants=network-online.target

[Service]
User=fyntune-agent
WorkingDirectory=/opt/fyntune-agent
# lean JVM for a small background process: about half the CPU and a third less memory than the defaults
ExecStart=/usr/bin/java -Xms16m -Xmx128m -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:MaxMetaspaceSize=64m -XX:ReservedCodeCacheSize=32m -Xss512k -XX:+ExitOnOutOfMemoryError -jar /opt/fyntune-agent/fyntune-agent.jar /opt/fyntune-agent/agent.json
Restart=always
# the app always comes first: the agent runs at low priority, never above half a core or 256 MB
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=50%
MemoryMax=256M
RestartSec=10
# read-only everywhere except its own folder (spool and state)
ProtectSystem=strict
ReadWritePaths=/opt/fyntune-agent
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
